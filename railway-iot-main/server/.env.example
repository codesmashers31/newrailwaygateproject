PORT=3000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/railway_iot

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key
ACCESS_TOKEN_EXPIRE=1d

# Email (required for OTP delivery)
MAIL_SERVICE=gmail
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_app_password

# Google OAuth (required only when using Google sign-in)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-service.onrender.com/api/auth/google/callback
